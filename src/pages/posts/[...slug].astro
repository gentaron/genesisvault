---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, postIndex: index },
  }));
}

const { post, postIndex } = Astro.props;
const { title, date, mood, weather, tags, description, keywords, agents } = post.data;

const { Content } = await post.render();

const formattedDate = new Date(date).toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long'
});

// 記事ページ固有の構造化データ（BlogPosting + BreadcrumbList）
const pageURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const postJsonLd: Record<string, unknown>[] = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'BlogPosting',
            '@id': pageURL ? new URL('#article', pageURL).href : undefined,
            headline: title,
            ...(description ? { description } : {}),
            datePublished: date.toISOString(),
            dateModified: date.toISOString(),
            ...(pageURL ? { url: pageURL.href, mainEntityOfPage: pageURL.href } : {}),
            inLanguage: 'ja-JP',
            author: { '@id': new URL('#person', Astro.site).href },
            publisher: { '@id': new URL('#person', Astro.site).href },
            isPartOf: { '@id': new URL('#website', Astro.site).href },
            ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
          },
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Home',
                item: Astro.site.href,
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: title,
                ...(pageURL ? { item: pageURL.href } : {}),
              },
            ],
          },
        ],
      },
    ]
  : [];
---

<BaseLayout
  title={`${title} — Genesis Vault`}
  description={description}
  keywords={keywords}
  ogType="article"
  publishedTime={date}
  jsonLd={postJsonLd}
>
  <article class="max-w-2xl mx-auto" style="max-width: 42rem; margin: 0 auto;">
    <header style="margin-bottom: 3rem; text-align: center;">
      <time datetime={date.toISOString()} class="text-sm" style="color: var(--color-gray-dark); display: block; margin-bottom: 1rem;">
        {formattedDate}
      </time>

      <h1 class="page-title" style="margin-bottom: 1.5rem;">
        {title}
      </h1>

      <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; color: var(--color-gray-dark);">
        {mood && <span style="font-size: 1.5rem;">{mood}</span>}
        {weather && <span style="font-size: 1.5rem;">{weather}</span>}
      </div>

      {tags.length > 0 && (
        <div class="tags" style="justify-content: center; margin-top: 1.5rem;">
          {tags.map((tag: string) => (
            <span class="tag">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div id="post-content" data-post-index={postIndex} data-pagefind-body>
      <div class="prose-custom">
        <Content />
      </div>
      {agents && (
        <div class="agent-badge" style="margin-top: 2rem; padding: 1rem; border-radius: 0.5rem; background: var(--color-soft-beige); font-size: 0.8rem; color: var(--color-gray-dark);">
          <p style="margin-bottom: 0.5rem;"><strong>Generated by Multi-Agent Pipeline</strong></p>
          <span>CEO: {agents.ceo}</span> &middot;
          <span>SEO: {agents.seo}</span> &middot;
          <span>Writer: {agents.writer}</span> &middot;
          <span>Editor: {agents.editor}</span>
        </div>
      )}
    </div>

    <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-gray-light);">
      <a href="/" style="color: var(--color-gentle-green);">
        &larr; Home
      </a>
    </footer>
  </article>
</BaseLayout>
