---
import '../styles/app.css';
import '../styles/global-legacy.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Genesis Vault — ミナ・エウレカ・エルンストの思考と日常を綴るデジタル日記',
  keywords = [],
  ogType = 'website',
  publishedTime,
  jsonLd,
} = Astro.props;

// Phase η: Umami analytics configuration (empty string = disabled)
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '';
const umamiHost = import.meta.env.PUBLIC_UMAMI_HOST || 'https://umami.example.com';

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL('/mina-profile.png', Astro.site) : '/mina-profile.png';

// ナビゲーションの現在位置（aria-current 用）
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/'
    ? currentPath === '/' || currentPath.startsWith('/posts')
    : currentPath.startsWith(href);

// サイト全体の構造化データ（WebSite + Person）。ページ固有のものは jsonLd プロップで追加される
const siteJsonLd: Record<string, unknown>[] = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': new URL('#website', Astro.site).href,
            url: Astro.site.href,
            name: 'Genesis Vault',
            description,
            inLanguage: 'ja-JP',
            publisher: { '@id': new URL('#person', Astro.site).href },
          },
          {
            '@type': 'Person',
            '@id': new URL('#person', Astro.site).href,
            name: 'Mina Eureka Ernst',
            url: Astro.site.href,
            description: '散歩・瞑想・ひとり旅・ジャーナリングをテーマに日記を書く。',
          },
        ],
      },
    ]
  : [];
const jsonLdArray: Record<string, unknown>[] = [
  ...siteJsonLd,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content="Mina Eureka Ernst" />
    <link rel="icon" type="image/png" href="/mina-profile.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Theme color follows the site palette (light / dark) -->
    <meta name="theme-color" content="#FAF9F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1A1A" media="(prefers-color-scheme: dark)" />

    <!-- PWA: Web App Manifest + iOS standalone support (ADR-0019) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Genesis Vault" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3)" href="/splash/splash-1290x2796.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3)" href="/splash/splash-1179x2556.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3)" href="/splash/splash-1284x2778.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3)" href="/splash/splash-1170x2532.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)" href="/splash/splash-1125x2436.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2)" href="/splash/splash-828x1792.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)" href="/splash/splash-750x1334.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3)" href="/splash/splash-1242x2208.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)" href="/splash/splash-2048x2732.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2)" href="/splash/splash-1668x2388.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 834px) and (device-height: 1112px) and (-webkit-device-pixel-ratio: 2)" href="/splash/splash-1668x2224.png" />
    <link rel="apple-touch-startup-image" media="(device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2)" href="/splash/splash-1536x2048.png" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Genesis Vault" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Mina Eureka Ernstのプロフィール画像" />
    <meta property="og:locale" content="ja_JP" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- RSS フィードの自動検出 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Genesis Vault"
      href={Astro.site ? new URL('rss.xml', Astro.site).href : '/rss.xml'}
    />

    {jsonLdArray.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdArray)} />
    )}

    <!-- Fonts: preconnect + non-blocking stylesheet (moved out of CSS @import) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600;700&family=Noto+Sans+JP:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Apply saved theme before first paint to avoid a light-mode flash -->
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      }
    </script>
    <!-- Phase η: Umami Analytics (privacy-friendly, self-hosted) -->
    <!-- Configure via PUBLIC_UMAMI_WEBSITE_ID and PUBLIC_UMAMI_HOST env vars -->
    <!-- See docs/adr/0007-observability.md for deployment instructions -->
    {umamiWebsiteId && (
      <script
        is:inline
        data-umami-id={umamiWebsiteId}
        data-umami-host={umamiHost}
        data-umami-domains="genesisvault.vercel.app"
        src="/js/analytics.js"
      ></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">本文へスキップ</a>
    <header>
      <nav class="container-custom" aria-label="グローバルナビゲーション">
        <a href="/" class="site-name">
          Genesis Vault
        </a>
        <div class="nav-links">
          <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
          <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
          <a href="/agents" aria-current={isCurrent('/agents') ? 'page' : undefined}>Agents</a>
          <a href="/status" aria-current={isCurrent('/status') ? 'page' : undefined}>Status</a>
          <button id="search-btn" type="button" aria-label="検索" aria-haspopup="dialog" title="記事を検索" style="background:none;border:none;cursor:pointer;color:inherit;padding:0;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
          <button id="theme-toggle" type="button" aria-label="ダークモード切替">
            <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Web3 Browser Recommendation Banner -->
    <div class="gv-web3-banner" id="web3-banner">
      <div class="container-custom gv-web3-banner-inner">
        <span class="gv-web3-banner-icon">&#x1F6E1;</span>
        <p class="gv-web3-banner-text">
          このサイトはウォレット接続機能を利用します。<strong>Brave</strong> などの Web3 対応ブラウザでのご利用を推奨します。
        </p>
        <button class="gv-web3-banner-close" id="web3-banner-close" aria-label="閉じる">&times;</button>
      </div>
    </div>

    <main id="main-content" class="container-custom" tabindex="-1" style="padding-bottom: 5rem;">
      <slot />
    </main>

    <footer>
      <div class="container-custom" style="text-align: center;">
        <p>&copy; 2026 Genesis Vault — Mina Eureka Ernst</p>
      </div>
    </footer>

    <!-- Phase η: Pagefind Search Dialog -->
    <dialog id="search-dialog" aria-labelledby="search-dialog-title" style="width: 80vw; max-width: 720px; padding: 2rem; border: 1px solid var(--color-gray-light, #e0d8cc); border-radius: 0.75rem; background: var(--color-bg, #faf9f7);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
        <h3 id="search-dialog-title" style="margin:0;font-size:1.1rem;">記事を検索</h3>
        <button id="search-close" aria-label="閉じる" style="background:none;border:none;cursor:pointer;font-size:1.5rem;color:var(--color-gray-dark,#888);">&times;</button>
      </div>
      <div id="pagefind-search"></div>
    </dialog>

    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
      const darkIcon = document.getElementById('theme-toggle-dark-icon');
      const lightIcon = document.getElementById('theme-toggle-light-icon');

      // The theme class is applied in <head> before paint — only sync icons here
      if (document.documentElement.classList.contains('dark')) {
        lightIcon.classList.remove('hidden');
      } else {
        darkIcon.classList.remove('hidden');
      }

      function syncThemeState() {
        themeToggle.setAttribute('aria-pressed', document.documentElement.classList.contains('dark') ? 'true' : 'false');
      }
      syncThemeState();

      themeToggle.addEventListener('click', function() {
        darkIcon.classList.toggle('hidden');
        lightIcon.classList.toggle('hidden');

        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
        syncThemeState();
      });
    </script>

    <script is:inline>
      (function() {
        var banner = document.getElementById('web3-banner');
        var closeBtn = document.getElementById('web3-banner-close');
        if (localStorage.getItem('gv_web3_banner_dismissed') === '1') {
          banner.style.display = 'none';
        }
        closeBtn.addEventListener('click', function() {
          banner.style.display = 'none';
          localStorage.setItem('gv_web3_banner_dismissed', '1');
        });
      })();
    </script>

    <!-- Phase η: Pagefind Search (lazy-loaded) -->
    <script is:inline>
      (function() {
        var searchBtn = document.getElementById('search-btn');
        var searchDialog = document.getElementById('search-dialog');
        var searchClose = document.getElementById('search-close');
        var searchLoaded = false;

        async function loadSearch() {
          if (searchLoaded) return;
          try {
            var pagefind = await import('/pagefind/pagefind.js');
            await pagefind.init();
            searchLoaded = true;

            // Create filter input
            var filterInput = document.createElement('input');
            filterInput.type = 'search';
            filterInput.placeholder = '検索キーワード...';
            filterInput.style.cssText = 'width:100%;padding:0.75rem 1rem;border:1px solid var(--color-gray-light,#e0d8cc);border-radius:0.5rem;font-size:1rem;background:var(--color-bg,#faf9f7);color:inherit;outline:none;';
            filterInput.id = 'pagefind-filter';
            document.getElementById('pagefind-search').prepend(filterInput);

            var resultsContainer = document.createElement('div');
            resultsContainer.id = 'pagefind-results';
            resultsContainer.style.cssText = 'margin-top:1rem;max-height:400px;overflow-y:auto;';
            document.getElementById('pagefind-search').appendChild(resultsContainer);

            filterInput.addEventListener('input', async function() {
              var query = filterInput.value.trim();
              resultsContainer.innerHTML = '';
              if (!query) return;
              var search = await pagefind.search(query);
              if (search.results.length === 0) {
                resultsContainer.innerHTML = '<p style="color:var(--color-gray-dark,#888);text-align:center;padding:1rem;">結果が見つかりませんでした</p>';
                return;
              }
              for (var i = 0; i < Math.min(search.results.length, 10); i++) {
                var result = await search.results[i].data();
                var link = document.createElement('a');
                link.href = result.url;
                link.style.cssText = 'display:block;padding:0.75rem;border-bottom:1px solid var(--color-gray-light,#e0d8cc);text-decoration:none;color:inherit;';
                link.innerHTML = '<strong>' + result.meta.title + '</strong><br><small style="color:var(--color-gray-dark,#888);">' + result.meta.description?.substring(0, 100) + '</small>';
                resultsContainer.appendChild(link);
              }
            });

            filterInput.focus();
          } catch (e) {
            document.getElementById('pagefind-search').innerHTML = '<p style="color:var(--color-gray-dark,#888);text-align:center;">検索インデックスの読み込みに失敗しました</p>';
          }
        }

        searchBtn.addEventListener('click', function() {
          searchDialog.showModal();
          loadSearch();
        });

        searchClose.addEventListener('click', function() {
          searchDialog.close();
        });

        searchDialog.addEventListener('click', function(e) {
          if (e.target === searchDialog) searchDialog.close();
        });

        // Cmd/Ctrl+K shortcut
        document.addEventListener('keydown', function(e) {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            searchDialog.showModal();
            loadSearch();
          }
        });
      })();
    </script>

    <!-- PWA: quiet update / install toast (ADR-0019) -->
    <div id="gv-pwa-toast" class="gv-pwa-toast" role="status" aria-live="polite" hidden>
      <p id="gv-pwa-toast-text" class="gv-pwa-toast-text"></p>
      <div class="gv-pwa-toast-actions">
        <button id="gv-pwa-toast-action" type="button" class="gv-pwa-toast-btn" hidden></button>
        <button id="gv-pwa-toast-close" type="button" class="gv-pwa-toast-close" aria-label="閉じる">&times;</button>
      </div>
    </div>

    {import.meta.env.PROD && (
      <script is:inline>
        (function () {
          var toast = document.getElementById('gv-pwa-toast');
          var toastText = document.getElementById('gv-pwa-toast-text');
          var toastAction = document.getElementById('gv-pwa-toast-action');
          var toastClose = document.getElementById('gv-pwa-toast-close');
          var hideTimer = null;
          var hideDelay = 0;
          var actionHandler = null;
          var dismissHandler = null;

          function showPwaToast(text, actionLabel, onAction, onDismiss, autoHideMs) {
            toastText.textContent = text;
            if (actionLabel && onAction) {
              toastAction.textContent = actionLabel;
              toastAction.hidden = false;
              actionHandler = onAction;
            } else {
              toastAction.hidden = true;
              actionHandler = null;
            }
            dismissHandler = onDismiss || null;
            toast.hidden = false;
            requestAnimationFrame(function () {
              toast.classList.add('is-visible');
            });
            if (hideTimer) clearTimeout(hideTimer);
            hideDelay = autoHideMs || 0;
            if (hideDelay) {
              hideTimer = setTimeout(hidePwaToast, hideDelay);
            }
          }

          function hidePwaToast() {
            if (hideTimer) {
              clearTimeout(hideTimer);
              hideTimer = null;
            }
            if (dismissHandler) {
              dismissHandler();
              dismissHandler = null;
            }
            toast.classList.remove('is-visible');
            setTimeout(function () {
              toast.hidden = true;
            }, 300);
          }

          toastAction.addEventListener('click', function () {
            var handler = actionHandler;
            actionHandler = null;
            dismissHandler = null;
            if (handler) handler();
            hidePwaToast();
          });
          toastClose.addEventListener('click', hidePwaToast);

          // インストール促し（Chromium）。静かに一度だけ。閉じたら90日間黙る。
          var deferredPrompt = null;
          window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            deferredPrompt = e;
            var dismissedAt = Number(localStorage.getItem('gv_install_dismissed_at') || 0);
            if (Date.now() - dismissedAt < 90 * 24 * 60 * 60 * 1000) return;
            showPwaToast(
              'ホーム画面に追加できます',
              '追加',
              function () {
                if (!deferredPrompt) return;
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then(function () {
                  deferredPrompt = null;
                }, function () {
                  deferredPrompt = null;
                });
              },
              function () {
                localStorage.setItem('gv_install_dismissed_at', String(Date.now()));
              },
              15000
            );
          });
          window.addEventListener('appinstalled', function () {
            localStorage.removeItem('gv_install_dismissed_at');
            deferredPrompt = null;
          });

          if (!('serviceWorker' in navigator)) return;

          var regRef = null;

          function showUpdateToast(worker) {
            showPwaToast('新しいバージョンがあります', '更新する', function () {
              worker.postMessage({ type: 'SKIP_WAITING' });
            }, null, 0);
          }

          window.addEventListener('load', function () {
            navigator.serviceWorker
              .register('/sw.js', { scope: '/' })
              .then(function (reg) {
                regRef = reg;
                if (reg.waiting && navigator.serviceWorker.controller) {
                  showUpdateToast(reg.waiting);
                }
                reg.addEventListener('updatefound', function () {
                  var installing = reg.installing;
                  if (!installing) return;
                  installing.addEventListener('statechange', function () {
                    if (installing.state === 'installed' && navigator.serviceWorker.controller) {
                      showUpdateToast(installing);
                    }
                  });
                });
              })
              .catch(function () {
                /* SW が動かない環境でもサイトはそのまま動く */
              });
          });

          // 再表示・オンライン復帰時に静かに更新を確認する
          function scheduleUpdateCheck() {
            if (regRef) regRef.update().catch(function () {});
          }
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') scheduleUpdateCheck();
          });
          window.addEventListener('online', scheduleUpdateCheck);

          var reloading = false;
          // 初回アクセスでは claim() による controllerchange が発生するが、
          // これは更新ではないのでリロードしない。更新フローでのみリロードする。
          var hadController = navigator.serviceWorker.controller !== null;
          navigator.serviceWorker.addEventListener('controllerchange', function () {
            if (!hadController) {
              hadController = true;
              return;
            }
            if (reloading) return;
            reloading = true;
            window.location.reload();
          });
        })();
      </script>
    )}
  </body>
</html>
