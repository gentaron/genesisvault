{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "agents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VE-\\d{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortName": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "roleJa": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "promptDir": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "shortName",
          "role",
          "roleJa",
          "step",
          "promptDir"
        ]
      }
    },
    "providers": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "chain": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sdk": {
                "type": "string",
                "enum": [
                  "google",
                  "groq",
                  "cerebras",
                  "openrouter",
                  "huggingface",
                  "typesafe",
                  "github-models",
                  "workers-ai"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "envKey": {
                "type": "string",
                "minLength": 1
              },
              "rpm": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rpd": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "sdk",
              "model",
              "envKey",
              "rpm",
              "rpd"
            ]
          }
        }
      },
      "required": [
        "chain"
      ]
    },
    "routing": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "default": {
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "light",
                "creative",
                "heavy",
                "precision",
                "judge"
              ]
            },
            "preferredProviders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "maxOutputTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "tier",
            "preferredProviders",
            "temperature",
            "maxOutputTokens"
          ]
        },
        "byAgent": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string",
                "enum": [
                  "light",
                  "creative",
                  "heavy",
                  "precision",
                  "judge"
                ]
              },
              "preferredProviders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "maxOutputTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "tier",
              "preferredProviders",
              "temperature",
              "maxOutputTokens"
            ]
          }
        }
      },
      "required": [
        "default",
        "byAgent"
      ]
    },
    "qualityGate": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "minBodyLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxBodyLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minH2Headings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "binaryContrastLimit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "penalty": {
          "type": "object",
          "properties": {
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "warning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "error",
            "warning"
          ]
        },
        "placeholderPatterns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grandioseHeadingPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clicheVocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "minBodyLength",
        "maxBodyLength",
        "minH2Headings",
        "binaryContrastLimit",
        "penalty",
        "placeholderPatterns",
        "grandioseHeadingPatterns",
        "clicheVocabulary"
      ]
    },
    "references": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "legacy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "legacy",
        "current"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "minScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "secondOpinionBand": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "maxJudgeAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "judgeTemperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "requireEvidence": {
          "type": "boolean"
        },
        "quarantineDir": {
          "type": "string",
          "minLength": 1
        },
        "auditLogDir": {
          "type": "string",
          "minLength": 1
        },
        "judgeProviders": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rubric": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "requiresBrief": {
                "type": "boolean"
              },
              "veto": {
                "type": "boolean"
              },
              "guidance": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label",
              "weight",
              "requiresBrief",
              "veto",
              "guidance"
            ]
          }
        }
      },
      "required": [
        "minScore",
        "secondOpinionBand",
        "maxJudgeAttempts",
        "judgeTemperature",
        "requireEvidence",
        "quarantineDir",
        "auditLogDir",
        "judgeProviders",
        "rubric"
      ]
    },
    "videoBrief": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "teamKey": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "titlePrefix": {
          "type": "string",
          "minLength": 1
        },
        "minSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minScenes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxScenes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minPoints": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxPoints": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxQueued": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxVerbatimChars": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ledgerFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "teamKey",
        "label",
        "titlePrefix",
        "minSeconds",
        "maxSeconds",
        "minScenes",
        "maxScenes",
        "minPoints",
        "maxPoints",
        "maxQueued",
        "maxVerbatimChars",
        "ledgerFile"
      ]
    },
    "trends": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cacheFile": {
          "type": "string",
          "minLength": 1
        },
        "maxCacheAgeDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tech": {
          "type": "object",
          "properties": {
            "hnEndpoint": {
              "type": "string",
              "format": "uri"
            },
            "arxivEndpoint": {
              "type": "string",
              "format": "uri"
            },
            "queries": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "arxivCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "maxSignals": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "minPoints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lookbackHours": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "hnEndpoint",
            "arxivEndpoint",
            "queries",
            "arxivCategories",
            "maxSignals",
            "minPoints",
            "lookbackHours"
          ]
        },
        "market": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "lookbackDays": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "flatBandPct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "symbols": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "symbol",
                  "label"
                ]
              }
            }
          },
          "required": [
            "endpoint",
            "lookbackDays",
            "flatBandPct",
            "symbols"
          ]
        }
      },
      "required": [
        "enabled",
        "timeoutMs",
        "cacheFile",
        "maxCacheAgeDays",
        "tech",
        "market"
      ]
    },
    "finance": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cacheFile": {
          "type": "string",
          "minLength": 1
        },
        "maxCacheAgeDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disclosure": {
          "type": "string",
          "enum": [
            "relative"
          ]
        },
        "assetlog": {
          "type": "object",
          "properties": {
            "spreadsheetId": {
              "type": "string",
              "minLength": 1
            },
            "sheets": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "spreadsheetId",
            "sheets"
          ]
        },
        "qaiz": {
          "type": "object",
          "properties": {
            "baseUrlEnv": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "pattern": "^\\/.*"
            }
          },
          "required": [
            "baseUrlEnv",
            "endpoint"
          ]
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "bigMovePct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "drawdownPct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "nearHighPct": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "bigMovePct",
            "drawdownPct",
            "nearHighPct"
          ]
        }
      },
      "required": [
        "enabled",
        "timeoutMs",
        "cacheFile",
        "maxCacheAgeDays",
        "disclosure",
        "assetlog",
        "qaiz",
        "thresholds"
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 2,
          "maximum": 255
        },
        "themeCooldownDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxTitleSimilarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jev": {
          "type": "object",
          "properties": {
            "transports": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "workers-ai",
                  "typesafe"
                ]
              }
            },
            "workersAiModel": {
              "type": "string",
              "minLength": 1
            },
            "accountIdEnv": {
              "type": "string",
              "minLength": 1
            },
            "tokenEnv": {
              "type": "string",
              "minLength": 1
            },
            "timeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "minConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "transports",
            "workersAiModel",
            "accountIdEnv",
            "tokenEnv",
            "timeoutMs",
            "minConfidence"
          ]
        },
        "weights": {
          "type": "object",
          "properties": {
            "symbolic": {
              "type": "number",
              "minimum": 0
            },
            "neural": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "symbolic",
            "neural"
          ]
        },
        "llmFallback": {
          "type": "boolean"
        },
        "auditLogDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "maxCandidates",
        "themeCooldownDays",
        "maxTitleSimilarity",
        "jev",
        "weights",
        "llmFallback",
        "auditLogDir"
      ]
    },
    "format": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": [
            "ideaz",
            "diary"
          ]
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "type": "string",
          "format": "uri"
        },
        "minChars": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxChars": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "profile",
        "dir",
        "upstream",
        "minChars",
        "maxChars"
      ]
    }
  },
  "required": [
    "version",
    "agents",
    "providers",
    "routing",
    "qualityGate",
    "references",
    "review",
    "videoBrief",
    "trends",
    "finance",
    "selection",
    "format"
  ]
}
