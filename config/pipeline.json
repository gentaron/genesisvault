{
  "$schema": "./pipeline.schema.json",
  "version": "1.0.0",
  "description": "Genesis Vault マルチエージェント・パイプラインの唯一の宣言的ソース。エージェント名簿・ルーティング・プロバイダーチェーン・品質ゲート閾値をここに集約する。TypeScript 側はこのファイルを読むだけで、値を持たない。編集したら `bun run verify` で検証すること。",
  "agents": [
    {
      "id": "VE-010",
      "name": "Tessa Brandt",
      "shortName": "Tessa",
      "role": "scout",
      "roleJa": "AI・最先端技術の話題と株式市場の地合いを収集（トレンド・レーダー）",
      "step": 1,
      "promptDir": "tessa"
    },
    {
      "id": "VE-004",
      "name": "Vera Holt",
      "shortName": "Vera",
      "role": "researcher",
      "roleJa": "過去記事から確定事実を抽出（継続性）",
      "step": 2,
      "promptDir": "vera"
    },
    {
      "id": "VE-005",
      "name": "Nova Harmon",
      "shortName": "Nova",
      "role": "balancer",
      "roleJa": "テーマバランス分析・ジャンル選定",
      "step": 3,
      "promptDir": "nova"
    },
    {
      "id": "VE-001",
      "name": "Lena Strauss",
      "shortName": "Lena",
      "role": "ceo",
      "roleJa": "トピック・切り口・タイトルの決定",
      "step": 4,
      "promptDir": "lena"
    },
    {
      "id": "VE-003",
      "name": "Chloe Verdant",
      "shortName": "Chloe",
      "role": "seo",
      "roleJa": "タグ・キーワード・メタディスクリプション生成",
      "step": 5,
      "promptDir": "chloe"
    },
    {
      "id": "VE-002",
      "name": "Sophia Nightingale",
      "shortName": "Sophia",
      "role": "writer",
      "roleJa": "本文執筆（1,000〜2,000字・日記体）",
      "step": 6,
      "promptDir": "sophia"
    },
    {
      "id": "VE-006",
      "name": "Iris Koenig",
      "shortName": "Iris",
      "role": "editor",
      "roleJa": "校正・品質チェック・ペルソナ一貫性確認",
      "step": 7,
      "promptDir": "iris"
    },
    {
      "id": "VE-007",
      "name": "Edda Lindgren",
      "shortName": "Edda",
      "role": "summarizer",
      "roleJa": "抽出事実を継続性台帳へ統合・逆行禁止ブリーフ生成",
      "step": 8,
      "promptDir": "edda"
    },
    {
      "id": "VE-008",
      "name": "Mira Falk",
      "shortName": "Mira",
      "role": "recorder",
      "roleJa": "投稿記事の確定事実を台帳へ記録・更新",
      "step": 9,
      "promptDir": "mira"
    },
    {
      "id": "VE-009",
      "name": "Runa Vogel",
      "shortName": "Runa",
      "role": "briefer",
      "roleJa": "公開記事から短尺動画のブリーフを起こし Linear へ渡す",
      "step": 10,
      "promptDir": "runa"
    }
  ],
  "providers": {
    "comment": "チェーン順＝フォールバック順。envKey が未設定のプロバイダーは自動的にチェーンから外れる（設定不要で縮退する）。すべて無料ティア。",
    "chain": [
      {
        "name": "gemini-2.5-flash-lite",
        "sdk": "google",
        "model": "gemini-2.5-flash-lite",
        "envKey": "GEMINI_API_KEY",
        "rpm": 15,
        "rpd": 1000
      },
      {
        "name": "gemini-2.5-flash",
        "sdk": "google",
        "model": "gemini-2.5-flash",
        "envKey": "GEMINI_API_KEY",
        "rpm": 10,
        "rpd": 250
      },
      {
        "name": "groq-llama-3.3-70b",
        "sdk": "groq",
        "model": "llama-3.3-70b-versatile",
        "envKey": "GROQ_API_KEY",
        "rpm": 30,
        "rpd": 14400
      },
      {
        "name": "cerebras-llama-3.3-70b",
        "sdk": "cerebras",
        "model": "llama-3.3-70b",
        "envKey": "CEREBRAS_API_KEY",
        "rpm": 30,
        "rpd": 14400
      },
      {
        "name": "openrouter-llama",
        "sdk": "openrouter",
        "model": "meta-llama/llama-3.3-70b-instruct:free",
        "envKey": "OPENROUTER_API_KEY",
        "rpm": 20,
        "rpd": 200
      },
      {
        "name": "openrouter-qwen",
        "sdk": "openrouter",
        "model": "qwen/qwen-2.5-72b-instruct:free",
        "envKey": "OPENROUTER_API_KEY",
        "rpm": 20,
        "rpd": 200
      },
      {
        "name": "openrouter-deepseek",
        "sdk": "openrouter",
        "model": "deepseek/deepseek-chat:free",
        "envKey": "OPENROUTER_API_KEY",
        "rpm": 20,
        "rpd": 200
      },
      {
        "name": "huggingface",
        "sdk": "huggingface",
        "model": "meta-llama/Llama-3.3-70B-Instruct",
        "envKey": "HF_TOKEN",
        "rpm": 10,
        "rpd": 500
      }
    ]
  },
  "routing": {
    "comment": "エージェントの仕事ごとに配線を変える。軽い分類は速い無料プロバイダーへ、日本語の長文執筆は最強の Gemini へ。preferredProviders に無いものは元のチェーン順で後続。",
    "default": {
      "tier": "heavy",
      "preferredProviders": [],
      "temperature": 0.85,
      "maxOutputTokens": 4096
    },
    "byAgent": {
      "VE-005": {
        "tier": "light",
        "preferredProviders": [
          "groq-llama-3.3-70b",
          "cerebras-llama-3.3-70b",
          "gemini-2.5-flash-lite"
        ],
        "temperature": 0.3,
        "maxOutputTokens": 512,
        "why": "小さな JSON 分類。速い無料枠を先に使い Gemini の RPD を温存。選定は安定させたいので低温度。"
      },
      "VE-001": {
        "tier": "creative",
        "preferredProviders": ["gemini-2.5-flash", "gemini-2.5-flash-lite", "groq-llama-3.3-70b"],
        "temperature": 0.9,
        "maxOutputTokens": 1024,
        "why": "日本語の企画・タイトル。創造性が要るので最強モデル＋高温度。"
      },
      "VE-003": {
        "tier": "light",
        "preferredProviders": [
          "gemini-2.5-flash-lite",
          "groq-llama-3.3-70b",
          "cerebras-llama-3.3-70b"
        ],
        "temperature": 0.4,
        "maxOutputTokens": 512,
        "why": "構造化メタデータ。タグ・キーワードの一貫性を優先し中低温度。"
      },
      "VE-002": {
        "tier": "heavy",
        "preferredProviders": ["gemini-2.5-flash", "gemini-2.5-flash-lite"],
        "temperature": 0.85,
        "maxOutputTokens": 4096,
        "why": "1,000〜2,000字の日本語日記。品質のボトルネックなので最強モデルを最優先。"
      },
      "VE-006": {
        "tier": "judge",
        "preferredProviders": ["gemini-2.5-flash", "gemini-2.5-flash-lite"],
        "temperature": 0.2,
        "maxOutputTokens": 4096,
        "why": "審査役には最も強いモデルを置く。書き手が雑でも審査が厳しければ差し戻して直せるが、審査が甘いと雑なものがそのまま外に出て、出た後は誰も止められない。弱いモデルの見逃しは画面に何も表示されないまま全部緑で通るため、ここを削るのが最も高くつく。温度は 0.2 — 校正者が創造的に書き換えないよう固定。"
      },
      "VE-009": {
        "tier": "creative",
        "preferredProviders": ["gemini-2.5-flash", "gemini-2.5-flash-lite", "groq-llama-3.3-70b"],
        "temperature": 0.6,
        "maxOutputTokens": 1024,
        "why": "記事から動画の切り口・トーン・ビジュアル方向性を起こす日本語の企画仕事。ブリーフの骨格（見出し・想定尺）は video-brief.ts が決めるので、モデルが返すのは中身だけ。テーマがすり替わると別テーマの動画が出来上がり、それを止める仕組みは下流に無いので温度は控えめ。"
      }
    }
  },
  "qualityGate": {
    "comment": "生成後の決定論的チェック。LLM を使わずここで落とせるものは全部ここで落とす。error は不合格（テンプレートへフォールバック）、warning は減点のみ。",
    "minBodyLength": 400,
    "maxBodyLength": 5000,
    "minH2Headings": 1,
    "binaryContrastLimit": 3,
    "penalty": {
      "error": 25,
      "warning": 10
    },
    "placeholderPatterns": [
      "\\[TODO\\]",
      "\\[TBD\\]",
      "\\[要補完\\]",
      "\\[後で書く\\]",
      "\\[PLACEHOLDER\\]",
      "ここに本文を入力",
      "本文は後で追加"
    ],
    "grandioseHeadingPatterns": [
      "見つけたもの",
      "気づいたこと",
      "教えてくれ(た|る)",
      "向き合う時間",
      "大切なこと",
      "という(選択|生き方)"
    ],
    "clicheVocabulary": ["真理", "美学", "境地", "本質"]
  },
  "references": {
    "comment": "文体・テーマ・継続性の参照源。current が正典（整合性チェックの基準）、legacy は文体サンプルのみ。",
    "legacy": ["gensnotes_1.md", "gensnotes_2.md"],
    "current": ["gensnotes_3.md", "gensnotes_4.md", "gensnotes_5.md"]
  },
  "review": {
    "comment": "囲い（審査層）の設定。設計原則は4つ。(1) 審査役には最強モデルを置く。(2) 審査は執筆と別の呼び出しで行い、審査側には仕様と成果物しか渡さない（書き手の自己評価にしない）。(3) モデルには観察だけをさせ、合否はコード側で決定論的に集計する（甘い採点を防ぐ）。(4) 審査できなかったときは通さない（fail-closed）。",
    "minScore": 70,
    "secondOpinionBand": 10,
    "maxJudgeAttempts": 3,
    "judgeTemperature": 0,
    "requireEvidence": true,
    "quarantineDir": ".gate-quarantine",
    "auditLogDir": "docs/gate-runs",
    "judgeProviders": ["gemini-2.5-flash", "gemini-2.5-flash-lite"],
    "rubric": [
      {
        "id": "brief_coverage",
        "label": "企画指示の論点を扱っているか",
        "weight": 30,
        "requiresBrief": true,
        "veto": false,
        "guidance": "指示された論点が原稿に実在するかだけを見る。読みやすさで加点しない。扱えていない論点は missing に列挙する。"
      },
      {
        "id": "theme_drift",
        "label": "テーマがすり替わっていないか",
        "weight": 15,
        "requiresBrief": true,
        "veto": true,
        "guidance": "指示と別のテーマに移っていたら veto。「関連はしている」は許容しない。指示の主題そのものを扱っていること。"
      },
      {
        "id": "concrete_specificity",
        "label": "具体があるか（抽象論に逃げていないか）",
        "weight": 20,
        "requiresBrief": false,
        "veto": false,
        "guidance": "数字・固有名・実際の行動・その日にしか起きなかった出来事があるか。どの日の記事にも貼り替えられる一般論だけで構成されていたら低評価。文字数と体裁は評価しない。"
      },
      {
        "id": "persona_consistency",
        "label": "ペルソナの一貫性",
        "weight": 10,
        "requiresBrief": false,
        "veto": false,
        "guidance": "一人称「わたし」、柔らかい日記体。ミナの人物像（独身・散歩・瞑想・貯金・投資）と矛盾しないこと。"
      },
      {
        "id": "ai_slop",
        "label": "AI 特有の言い回しが無いか",
        "weight": 15,
        "requiresBrief": false,
        "veto": false,
        "guidance": "提案型の抽象的な見出し、「真理」「美学」「境地」「本質」等の誇張語彙、「A ではなく B」の反復、装飾的な全角ダッシュ、本文に残った Markdown 太字。"
      },
      {
        "id": "internal_consistency",
        "label": "記事内・既知事実との整合",
        "weight": 10,
        "requiresBrief": false,
        "veto": true,
        "guidance": "記事内で矛盾していないか。貯金額など既知の到達点を逆行させていないか（逆行は veto）。"
      }
    ]
  },
  "videoBrief": {
    "comment": "公開した記事から短尺動画のブリーフを起こし、Linear の Todo + agent-ready に積むための設定（VE-009 Runa）。minScenes/maxScenes/minSeconds/maxSeconds は VAIZ 側 scripts/video/plan.mjs の PlanSchema の受け入れ条件と一致させること——ここだけ動かすと、VAIZ が組めない企画を毎晩生成して Issue が差し戻され続ける。",
    "teamKey": "GEN",
    "label": "agent-ready",
    "titlePrefix": "動画：",
    "minSeconds": 45,
    "maxSeconds": 60,
    "minScenes": 6,
    "maxScenes": 8,
    "minPoints": 4,
    "maxPoints": 7,
    "maxQueued": 3,
    "maxVerbatimChars": 60,
    "ledgerFile": "data/video-briefs.json"
  },
  "trends": {
    "comment": "VE-010 Tessa のトレンド・レーダー。AI/最先端技術の話題（Hacker News・arXiv）と株式市場の地合い（Stooq の日足）を取り、企画と執筆に「今日の外の景色」を渡す。API キーを要求するソースは足さないこと——鍵の有無で挙動が変わると、鍵の無い環境でだけ壊れる。取得できない日は degraded として続行する（fail-soft）。検証コマンドからは絶対に呼ばない（INV-004）。",
    "enabled": true,
    "timeoutMs": 8000,
    "cacheFile": "data/trend-radar.json",
    "maxCacheAgeDays": 3,
    "tech": {
      "hnEndpoint": "https://hn.algolia.com/api/v1/search",
      "arxivEndpoint": "https://export.arxiv.org/api/query",
      "queries": ["AI", "LLM", "robotics"],
      "arxivCategories": ["cs.AI"],
      "maxSignals": 6,
      "minPoints": 100,
      "lookbackHours": 48
    },
    "market": {
      "endpoint": "https://stooq.com/q/d/l/",
      "lookbackDays": 45,
      "flatBandPct": 1.5,
      "symbols": [
        { "symbol": "^spx", "label": "S&P500" },
        { "symbol": "^nkx", "label": "日経平均" },
        { "symbol": "usdjpy", "label": "ドル円" },
        { "symbol": "btcusd", "label": "ビットコイン" }
      ]
    }
  }
}
